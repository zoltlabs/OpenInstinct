{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm --filter @openinstinct/web build",
  "outputDirectory": "apps/web/.next",
  "ignoreCommand": "sh \"$(git rev-parse --show-toplevel)/scripts/vercel-ignore-build.sh\"",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  }
}
