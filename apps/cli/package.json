{
  "name": "@openinstinct/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "openinstinct": "./dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@openinstinct/db": "workspace:*",
    "@openinstinct/messaging": "workspace:*",
    "@openinstinct/runtime": "workspace:*",
    "commander": "15.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
