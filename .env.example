# Public web configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credentials
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# Base64-encoded 32-byte key. Generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=

# Versioned credential-vault wrapping keys. Setup generates this JSON value.
# Losing all listed keys fails closed and requires re-entering website credentials.
CREDENTIAL_VAULT_KEYS=

# Messaging
BLOOIO_API_KEY=
BLOOIO_WEBHOOK_SECRET=
BLOOIO_CHANNEL_ID=
# Bootstrap value; onboarding stores the verified runtime recipient in Postgres.
BLOOIO_OWNER_PHONE=
OWNER_EMAIL=

# AI inference. Direct providers are available; Vercel setup defaults to AI Gateway.
# Providers: openai, anthropic, google, openrouter, vercel-gateway, openai-compatible
AI_PROVIDER=openai
AI_MODEL=gpt-5.6-sol
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=

# Optional per-generation fallback. Set both fields or leave both empty.
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=

# Optional routing/compatible providers. AI Gateway is not required.
AI_GATEWAY_API_KEY=
AI_COMPATIBLE_BASE_URL=
AI_COMPATIBLE_API_KEY=

# Direct Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional browser runtime
KERNEL_API_KEY=

# Protects internal queue-consumer endpoints
INTERNAL_API_SECRET=
# Set automatically by Vercel when using Vercel Cron; optional elsewhere.
CRON_SECRET=
WORKER_URL=
