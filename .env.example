# Public web configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credentials
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# Base64-encoded 32-byte key. Generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=

# Messaging
BLOOIO_API_KEY=
BLOOIO_WEBHOOK_SECRET=
BLOOIO_CHANNEL_ID=
BLOOIO_OWNER_PHONE=
OWNER_EMAIL=

# Inference through Vercel AI Gateway by default
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-5.6-sol

# Direct Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/connectors/google/callback

# Optional browser runtime
KERNEL_API_KEY=

# Protects internal queue-consumer endpoints
INTERNAL_API_SECRET=
# Set automatically by Vercel when using Vercel Cron; optional elsewhere.
CRON_SECRET=
WORKER_URL=
