{
  "name": "openinstinct",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @openinstinct/web build && pnpm --filter @openinstinct/cli build",
    "check": "pnpm format:check && pnpm typecheck && pnpm test",
    "dev": "node --env-file=.env.local scripts/dev.mjs",
    "doctor": "tsx apps/cli/src/index.ts doctor",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "tsx apps/cli/src/index.ts setup",
    "smoke": "tsx apps/cli/src/index.ts smoke",
    "openinstinct": "tsx apps/cli/src/index.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:test": "supabase test db",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "prettier": "3.6.2",
    "supabase": "2.116.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "ai": "7.0.83"
  }
}
